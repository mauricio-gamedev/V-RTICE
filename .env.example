# Copy to .env before running docker compose. Never commit your real .env.
POSTGRES_DB=vertice
POSTGRES_USER=vertice
POSTGRES_PASSWORD=change-this-local-database-password
DATABASE_POOL_SIZE=8

# Generate a unique random value of at least 32 bytes for every environment.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes-123456789
JWT_ISSUER=vertice-api
JWT_AUDIENCE=vertice-android
